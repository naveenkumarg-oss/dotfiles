# -*-mode:gitconfig-*- vim:ft=gitconfig

# ~/.gitconfig_alias
# =============================================================================
# Aliases for Git sourced by `~/.gitconfig`.

[alias]
    # 💡 Show all defined aliases
    aliases = config --get-regexp ^alias\\.

    # 🧩 Amend last commit using current staged changes (without changing message)
    amend = commit --amend --no-edit

    # 🌿 List local branches
    br = branch

    # 🌍 List all branches (local + remote)
    branches = branch -a -vv

    # 📦 Clone repository with all submodules
    clone-all = clone --recurse-submodules

    # 💬 Commit all tracked + untracked files interactively (adds + commits)
    commit-all = "!git add -A && git commit -v"

    # 🔥 Show top changed files by frequency (most churned)
    churn = "!git --no-pager log --name-only --oneline | grep -v ' ' | sort | uniq -c | sort -nr | head"

    # 💾 Standard commit
    ci = commit

    # ⚔️ Show files currently in conflict
    conflicts = diff --name-only --diff-filter=U

    # 🧑‍💻 List contributors with commit counts
    contributors = shortlog -sn --all --no-merges

    # 🍒 Apply commits by hash to current HEAD
    pick = cherry-pick

    # 🏷️ Credit someone else on the last commit
    credit = "!f() { git commit --amend --author \"$1 <$2>\" --no-edit; }; f"

    # 🧾 Diff current changes vs. last commit
    diff = diff --patch-with-stat

    # 🕓 Diff between current state and N commits ago
    diff-n = "!f() { git diff --patch-with-stat HEAD~${1:-1}; }; f"

    # 🧹 Delete all merged branches (safe delete)
    clean-merged = "!git branch --merged main | grep -vE '^(\\*|main)$' | xargs -r git branch -d"

    # 🔍 Pretty print internal object
    dump = cat-file -p

    # 🔎 Find branches containing a commit
    find-branch = "!f() { git branch -a --contains ${1:-HEAD}; }; f"

    # 🔎 Search commits containing a string in code
    find-code = "!f() { git log --color --decorate --date=short -S\"$1\" --pretty=format:'%C(yellow)%h%Creset %Cblue%ad%Creset %s %Cgreen[%cn]%Creset'; }; f"

    # 🔎 Search commits by message
    find-msg = "!f() { git log --color --decorate --date=short --grep=\"$1\" --pretty=format:'%C(yellow)%h%Creset %Cblue%ad%Creset %s %Cgreen[%cn]%Creset'; }; f"

    # 🔖 Find tags containing commit
    find-tag = "!f() { git describe --always --contains ${1:-HEAD}; }; f"

    # 🔁 Switch branches safely
    sw = switch

    # 🚀 Create or switch to branch
    go = "!f() { git switch -C \"$1\" 2>/dev/null || git switch \"$1\"; }; f"

    # 🧠 Grep ignoring binary and case (avoid alias name collision with built-in grep)
    gsearch = grep -Ii

    # 🪶 Show concise recent commit history (20 latest)
    lg = log --oneline --graph -n 20 --abbrev-commit

    # 🎨 Pretty log with branch decorations, authors, and relative times
    ll = log --color --graph --abbrev-commit --decorate \
        --pretty=format:'%C(red)%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset %C(bold blue)<%an>%Creset'

    # 📆 Log with commit dates (short date)
    ld = log --graph --date=short \
        --pretty=format:'%C(red)%h%Creset %Cgreen%ad%Creset | %s%C(auto)%d%Creset %C(bold blue)<%an>%Creset'

    # 🧭 Check repo integrity and find lost objects
    lost = fsck --lost-found

    # ⬇️ Pull with submodules
    pull-all = pull --recurse-submodules

    # ⬆️ Push current branch and set upstream tracking
    push-up = push -u origin HEAD

    # 🚫 Safe force-push
    push-safe = push --force-with-lease

    # 🚫 Abort ongoing rebase
    rebase-abort = rebase --abort

    # ▶️ Continue rebase after resolving conflicts
    rebase-continue = "!git add -A && git rebase --continue"

    # ✏️ Interactive rebase for N latest commits
    rebase-n = "!f() { git rebase -i HEAD~${1:-5}; }; f"

    # 🌐 Show all remotes and URLs
    remotes = remote -v

    # ♻️ Save state, then reset to commit
    restore-to = "!f() { git add -A && git commit -qm 'RESTORE SAVEPOINT'; git reset --hard ${1:-HEAD}; }; f"

    # 🔁 Delete + recreate a tag locally and remotely
    retag = "!f() { git tag -d \"$1\" 2>/dev/null; git push origin :refs/tags/\"$1\"; git tag \"$1\"; }; f"

    # 🧩 Short status
    st = status -sb

    # 📍 Save temporary commit (savepoint)
    save = "!git add -A && git commit -m 'SAVEPOINT'"

    # 🔗 Change remote origin URL
    set-origin = remote set-url origin

    # 🔗 Change upstream URL
    set-upstream = remote set-url upstream

    # 📊 Show repository disk usage
    size = count-objects -vH

    # 🔄 Pull + sync all submodules recursively
    sync-pull = "!git pull --rebase --autostash && git submodule sync --recursive && git submodule update --init --recursive"

    # 🚀 Push including submodules if needed
    sync-push = push --recurse-submodules=on-demand

    # 📦 View detailed status
    status = status

    # 💾 List all stashes
    stashes = stash list

    # 🔁 Full sync: pull (rebase) + push
    sync = "!git pull --rebase --autostash && git push"

    # 🏷️ List all tags
    tags = tag -l

    # 🧱 Show object type
    type = cat-file -t

    # ↩️ Undo last commit but keep changes staged
    uncommit = reset --soft HEAD^

    # ↩️ Undo last commit but keep changes unstaged
    undo = reset --mixed HEAD~1

    # ❌ Discard working directory and staging area changes for a file
    discard = restore --staged --worktree --

    # 🧺 Unstage a file (keep in working directory)
    unstage = restore --staged --

    # ⬆️ Pull with rebase and auto stash — safest modern pull
    up = pull --rebase --autostash --prune --recurse-submodules

    # 🧩 Commit "Work In Progress"
    wip = commit -am "WIP"

    # 🧼 Create wipepoint and hard reset to given commit
    wipe = "!f() { rev=$(git rev-parse ${1:-HEAD}); git add -A && git commit --allow-empty -qm 'WIPE SAVEPOINT' && git reset --hard $rev; }; f"
